# AI闪念笔记 - 开发环境配置

# 应用配置
APP_NAME=AI闪念笔记
APP_VERSION=0.1.0
DEBUG=True
SECRET_KEY=dev-secret-key-change-in-production

# 数据库配置 - 开发环境
DATABASE_URL=postgresql://postgres:dev_password_123@localhost:5432/ai_note_dev
MONGODB_URL=mongodb://localhost:27017/ai_note_dev
REDIS_URL=redis://localhost:6379/0

# Celery配置
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# JWT配置 - 开发环境
JWT_SECRET_KEY=dev-jwt-secret-key-change-in-production-environment
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# 安全配置
PASSWORD_MIN_LENGTH=8
MAX_LOGIN_ATTEMPTS=5
LOGIN_ATTEMPT_TIMEOUT_MINUTES=15

# AI服务配置 (可选，用于测试)
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# CORS配置
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001

# 开发环境特定配置
ENVIRONMENT=development
LOG_LEVEL=DEBUG

# 数据库连接池配置
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=3600

# 缓存配置
CACHE_TTL_DEFAULT=3600
CACHE_TTL_SESSION=1800
CACHE_TTL_USER_PREFERENCES=86400

# 限流配置
RATE_LIMIT_ENABLED=True
RATE_LIMIT_STORAGE_URL=redis://localhost:6379/3
